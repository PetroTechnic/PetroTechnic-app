{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized internal team member with role-based access control for the PetroTechnics Superadmin Console.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["superadmin", "editor", "desk_agent", "analyst"]
        },
        "roleId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roleName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "permissions": {
          "type": "object"
        },
        "status": {
          "type": "string",
          "enum": ["active", "disabled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "roleId", "roleName", "permissions", "status", "createdAt", "updatedAt"]
    },
    "RoleDefinition": {
      "title": "RoleDefinition",
      "description": "Superadmin-defined granular access role template with explicit module-level permission flags.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300
        },
        "baseTier": {
          "type": "string",
          "enum": ["superadmin", "editor", "desk_agent", "analyst"]
        },
        "isSystem": {
          "type": "boolean"
        },
        "permissions": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "description", "baseTier", "isSystem", "permissions", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Petrochemical, polymer, fertilizer, or industrial chemical export catalog item with live FOB USD/MT pricing.",
