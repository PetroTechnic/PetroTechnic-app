          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["polymers", "fertilizers", "chemicals"]
        },
        "shortName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "formula": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "casNumber": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "hsCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24
        },
        "moqMt": {
          "type": "number"
        },
        "fobUsdMt": {
          "type": "number"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "featured": {
          "type": "boolean"
        },
        "name": {
          "type": "object"
        },
        "summary": {
          "type": "object"
        },
        "overview": {
          "type": "object"
        },
        "grades": {
          "type": "array"
        },
        "specs": {
          "type": "array"
        },
        "applications": {
          "type": "array"
        },
        "packaging": {
          "type": "array"
        },
        "loadingPorts": {
          "type": "array"
        },
        "inspections": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "slug",
        "category",
        "shortName",
        "formula",
        "casNumber",
        "hsCode",
        "moqMt",
        "fobUsdMt",
        "image",
        "featured",
        "name",
        "summary",
        "overview",
        "grades",
        "specs",
        "applications",
        "packaging",
        "loadingPorts",
        "inspections",
        "updatedAt"
      ]
    },
    "RfqInquiry": {
      "title": "RfqInquiry",
      "description": "Commercial buyer Request for Quotation with tonnage, Incoterm 2020, currency valuation, and deal desk pipeline status.",
      "type": "object",
      "properties": {
        "referenceId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productSlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "grade": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "quantityMt": {
          "type": "number"
        },
        "destination": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "incoterm": {
          "type": "string",
          "enum": ["FOB", "CFR", "CIF", "FCA", "CPT", "DAP"]
        },
        "packaging": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "inspection": {
          "type": "string",
          "enum": ["SGS", "Bureau Veritas", "Intertek"]
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "EUR", "AED"]
        },
        "estimatedUnitPrice": {
          "type": "number"
        },
        "estimatedTotal": {
          "type": "number"
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "contactName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["received", "reviewing", "quoted", "contracted", "archived"]
        },
        "deskNotes": {
          "type": "string",
          "maxLength": 2000
        },
        "buyerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fulfillmentStage": {
          "type": "string",
          "enum": ["allocation", "lc_opened", "sgs_inspection", "port_loading", "in_transit", "delivered"]
        },
        "vesselName": {
          "type": "string",
          "maxLength": 120
        },
        "blNumber": {
          "type": "string",
          "maxLength": 80
        },
        "portOfLoading": {
          "type": "string",
          "maxLength": 120
        },
        "etaDate": {
          "type": "string",
          "maxLength": 40
        },
        "buyerNotice": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "referenceId",
        "productSlug",
        "productName",
        "grade",
        "quantityMt",
        "destination",
        "incoterm",
        "packaging",
        "inspection",
        "currency",
        "estimatedUnitPrice",
        "estimatedTotal",
        "companyName",
        "contactName",
        "email",
        "phone",
        "notes",
        "status",
        "deskNotes",
        "createdAt",
        "updatedAt"
      ]
    },
