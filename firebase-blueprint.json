        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["token", "company", "email", "status", "verifiedAt", "updatedAt"]
