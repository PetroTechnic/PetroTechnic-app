    "DocumentAccessLog": {
      "title": "DocumentAccessLog",
      "description": "PII-isolated buyer verification audit record for Secure Document Hub access.",
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "minLength": 6,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "company": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 160
        },
