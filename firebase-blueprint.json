  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "RBAC directory for internal team operators with assigned granular RoleDefinition IDs and synced permission snapshots."
    },
    "/role_definitions/{roleId}": {
      "schema": { "$ref": "#/entities/RoleDefinition" },
      "description": "Superadmin-managed granular access level templates (e.g., Superadmin, Pricing Manager, Sales Lead, Read-Only Analyst, and custom roles)."
    },
    "/products/{productSlug}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Live petrochemical export catalog and FOB USD/MT benchmark pricing."
    },
    "/rfq_inquiries/{rfqId}": {
      "schema": { "$ref": "#/entities/RfqInquiry" },
      "description": "Confidential buyer RFQ pipeline and shipment fulfillment records (admin-managed, buyer-owned verified read/list, public validated create)."
    },
    "/market_insights/{insightSlug}": {
      "schema": { "$ref": "#/entities/MarketInsight" },
      "description": "Trilingual market research articles (published publicly readable, drafts superadmin-only)."
    },
    "/historical_prices/{priceId}": {
      "schema": { "$ref": "#/entities/HistoricalPricePoint" },
      "description": "Monthly Middle East FOB price series powering the Recharts volatility dashboard."
    },
    "/trade_corridors/{corridorId}": {
      "schema": { "$ref": "#/entities/TradeCorridor" },
      "description": "Global maritime, Caspian, Gulf, and overland export corridors powering the D3 map."
    },
    "/document_templates/{templateId}": {
      "schema": { "$ref": "#/entities/DocumentTemplate" },
      "description": "Institutional trade document sample templates (PI, B/L, SGS, FCO, COO, COA)."
    },
    "/document_access_logs/{tokenId}": {
      "schema": { "$ref": "#/entities/DocumentAccessLog" },
      "description": "PII-protected Document Hub verification audit log (admin-only read/list/revoke)."
    },
    "/vault_revocations/{tokenId}": {
      "schema": { "$ref": "#/entities/VaultRevocation" },
      "description": "Split-collection non-PII token revocation registry for instant download enforcement."
    },
    "/platform_settings/{settingKey}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Global commercial configuration (live FX rates, Incoterm deltas, regional desks, FAQs)."
    },
    "/system_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/SystemAuditLog" },
      "description": "Immutable append-only administrative audit log tracking pricing updates, RFQ status transitions, role modifications, and vault revocations."
    },
    "/buyer_profiles/{uid}": {
      "schema": { "$ref": "#/entities/BuyerProfile" },
      "description": "Registered institutional buyer account profiles for the Client Portal, strictly isolated to owner UID and authorized sales admins."
    }
  }
}
